# Optional AI features. Both providers are optional and used only on the server.
# Without either key, the page assistant chat (features/prompt-assist) tells the
# person no provider is configured and lets them pick a template by hand; the
# rest of the app is unaffected. When a key is set, the text of the person's
# request (and a compact description of the page) is sent to that provider.

# TypeSafe (Jev) — chooses the best template from the catalog and judges whether
# the page already satisfies the request. Get a key at https://console.typesafe.ai.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# OpenAI — asks clarifying questions, drafts copy, proposes design-setting edits,
# and stands in as the template judge when Jev is not configured or is down.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Abuse and cost protection (0 disables). Counters live in process memory, so on
# serverless hosts they are best-effort; also set a spend cap on both accounts.
# Requests each client (by IP) may make per minute to /api/prompt-assist/match and /draft.
PROMPT_ASSIST_RATE_LIMIT_PER_MINUTE=20
# The same for /api/prompt-assist/refine, which one assist run calls several times.
PROMPT_ASSIST_REFINE_RATE_LIMIT_PER_MINUTE=60
# Total outbound calls per minute to each provider; when spent, that provider is
# treated as unavailable and the other one (or the manual template picker) takes over.
TYPESAFE_CALLS_PER_MINUTE=120
OPENAI_CALLS_PER_MINUTE=120
