# Prompt-assist chat (features/prompt-assist) — both providers below are
# optional. With neither key set, the chat still works end-to-end using
# deterministic keyword ranking and the raw prompt as the draft copy.

# TypeSafe (Jev) — disambiguates a template match only when the
# deterministic ranking in features/prompt-assist/select-template.ts finds
# several near-tied candidates. Get a key at https://console.typesafe.ai.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# OpenAI — drafts name/headline/summary copy for the matched template.
# Defaults to gpt-5-nano, a small low-cost model, since drafting a few short
# fields is a low-stakes generation task.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Rate limiting for /api/prompt-assist/* (0 disables). Counters are kept in
# memory per server instance, so on serverless hosts these are best-effort;
# also set a spend cap on the TypeSafe and OpenAI accounts.
# Requests each client (by IP) may make to each route per minute; excess gets a 429.
PROMPT_ASSIST_RATE_LIMIT_PER_MINUTE=20
# Total outbound TypeSafe and OpenAI calls per minute (each provider counted
# separately). When spent, the chat falls back to the deterministic path.
PROMPT_ASSIST_PROVIDER_BUDGET_PER_MINUTE=120
