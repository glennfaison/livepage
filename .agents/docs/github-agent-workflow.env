# LivePage overrides for the github-agent-workflow package.
# Plain shell assignments, sourced after the package's config.defaults.env. Only keys that differ are set.

PR_BASE_BRANCH="develop"        # main only accepts PRs from develop
MERGE_METHOD="squash"
HUMAN_REVIEWER="glennfaison"

BUILD_CMD="npm run build"
GIT_HOOKS_PATH="scripts/git-hooks"
REPO_GUIDANCE="AGENTS.md .agents/docs/AGENT-WORKFLOW.md .agents/docs/BRANCH-NAMES.md"
