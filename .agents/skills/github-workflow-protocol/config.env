# Workflow configuration. Plain shell assignments: agents read it, scripts/agent/lib.sh sources it.
# Change values here only; the github-workflow skills refer to these names.

# --- Exploring ---
EXPLORE_BASE_URL="https://livepagecrafter-dev.vercel.app/"
EXPLORE_ISSUE_CAP=10            # file at most this many new issues per run
EXPLORE_DEDUPE_CLOSED_DAYS=30   # "recently closed" window for duplicate search
EXPLORE_LOG_LOOKBACK_DAYS=14    # how far back Exploring reads the run log

# --- Leases (how long a claim stays valid without renewal; GNU `date -d` syntax) ---
LEASE_TTL_TRIAGE="1 hour"       # Grooming
LEASE_TTL_IMPLEMENT="3 hours"   # Implementing
LEASE_TTL_PR="1 hour"           # Shepherding, Reviewing

# --- Batch sizes: max items one run handles before it stops ---
GROOM_BATCH=5
IMPLEMENT_BATCH=1
SHEPHERD_BATCH=3
REVIEW_BATCH=3

# --- Escalation limits ---
MAX_SHEPHERD_ATTEMPTS=3         # consecutive Shepherding fix attempts, reset by any handoff
MAX_REVIEW_ROUNDS=3             # Reviewing runs that did not merge (ASSUMPTION: tune after a few weeks)

# --- Misc ---
PR_BASE_BRANCH="develop"       # agent PRs target this branch (main only accepts PRs from develop)
MERGE_METHOD="squash"           # ASSUMPTION: squash | merge | rebase
HUMAN_REVIEWER="glennfaison"    # ASSUMPTION: who escalate.md requests review from
