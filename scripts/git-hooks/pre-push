#!/bin/sh
# Hard gate: refuse to push any branch whose name does not comply with
# check-branch-name.mjs. Dependabot branches (refs/heads/dependabot/**) are
# allowed; everything else must match gitflow. Server-side rules and CI are
# still the backstop for actors that skip this hook.
root=$(git rev-parse --show-toplevel) || exit 1
while read -r local_ref local_sha remote_ref remote_sha; do
  branch=${remote_ref#refs/heads/}
  if [ -z "$branch" ] || [ "$branch" = "$remote_ref" ]; then
    continue
  fi
  if ! node "$root/scripts/check-branch-name.mjs" --branch "$branch"; then
    echo "Refusing to push branch \"$branch\": see message above." >&2
    exit 1
  fi
done
exit 0